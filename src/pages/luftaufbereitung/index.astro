---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<p>In der Kategorie Luftaufbereitung finden Sie verschiedene Produkte zur Aufrechterhaltung der Luftqualität zu Hause oder am Arbeitsplatz. Denken Sie an einen Aroma-Diffusor, eine Luftbefeuchter, einen Luftentfeuchter, einen Luftreiniger und vieles mehr. Sehen Sie sich alle unsere ausführlichen Bewertungen zu den Produkten in der Kategorie Luftaufbereitung an.</p>\n<ul><li>Aroma-Diffusor</li></ul>\n<ul><li>Luftbefeuchter</li><li>Luftentfeuchter</li><li><a href=\"/beste-luftreiniger/\">Luftreiniger</a></li></ul>\n<ul><li><a href=\"/beste-ventilator/\">Ventilator</a></li></ul>\n<ul><li><a href=\"/beste-weihrauch/\">Weihrauch</a></li></ul>"]];
const faq = [];
---
<PageLayout
  title={"Luftaufbereitung - erwachsenenfragen.de"}
  description={"In der Kategorie Luftaufbereitung finden Sie verschiedene Produkte zur Aufrechterhaltung der Luftqualität zu Hause oder am Arbeitsplatz. Denken Sie an einen Aroma-Diffusor, eine Luftbefeuchter, einen Luftentfeuchter, einen Luftreiniger und vieles mehr. Sehen Sie sich alle unsere ausführlichen Bewertungen zu den Produkten in der Kategorie Luftaufbereitung an."}
  h1={"Luftaufbereitung"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
