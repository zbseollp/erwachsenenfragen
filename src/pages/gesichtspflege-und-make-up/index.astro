---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<p>In der Kategorie Gesichtspflege und Make-up finden Sie verschiedene Produkte zur Pflege Ihres Gesichts. Denken Sie an einen Abdeckstift, eine Gesichtsepilierer, ein Gesichtsreiniger, einen Lippenbalsam, einen Make up Schwamm, einen Rasierapparat, einen Rasierpinsel und vieles mehr. Schauen Sie sich alle unsere ausführlichen Bewertungen zu den Produkten in der Kategorie Gesichtspflege und Make-up an.</p>\n<ul><li><a href=\"/beste-abdeckstift/\">Abdeckstift</a></li></ul>\n<ul><li><a href=\"/beste-entwickler/\">Entwickler</a></li><li><a href=\"/beste-epilierer/\">Epilierer</a></li></ul>\n<ul><li><a href=\"/beste-foundation-pinsel/\">Foundation-Pinsel</a></li></ul>\n<ul><li><a href=\"/beste-gesichtsepilierer/\">Gesichtsepilierer</a></li><li><a href=\"/beste-gesichtsreiniger/\">Gesichtsreiniger</a></li></ul>\n<ul><li><a href=\"/beste-lippenbalsam/\">Lippenbalsam</a></li><li><a href=\"/beste-lippenstift/\">Lippenstift</a></li></ul>\n<ul><li><a href=\"/beste-make-up-schwamm/\">Make up Schwamm</a></li></ul>\n<ul><li>Rasierapparat</li><li><a href=\"/beste-rasierpinsel/\">Rasierpinsel</a></li><li><a href=\"/beste-rasierspiegel/\">Rasierspiegel</a></li></ul>"]];
const faq = [];
---
<PageLayout
  title={"Gesichtspflege und Make-up - erwachsenenfragen.de"}
  description={"In der Kategorie Gesichtspflege und Make-up finden Sie verschiedene Produkte zur Pflege Ihres Gesichts. Denken Sie an einen Abdeckstift, eine Gesichtsepilierer, ein Gesichtsreiniger, einen Lippenbalsam, einen Make up Schwamm, einen Rasierapparat, einen Rasierpinsel und vieles mehr. Schauen Sie sich alle unsere ausführlichen Bewertungen zu den Produkten in der Kategorie Gesichtspflege und Make-up an."}
  h1={"Gesichtspflege und Make-up"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
