---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<p>In der Kategorie Körperpflege finden Sie verschiedene Produkte zur Pflege Ihres Körpers. Denken Sie an einen Badeschaum, ein Entgiftungstee, einen Damenrasierer, einen Duschschaum und vieles mehr. Sehen Sie sich alle unsere ausführlichen Bewertungen der Artikel in der Kategorie Körperpflege an.</p>\n<ul><li>Badeschaum</li></ul>\n<ul><li><a href=\"/beste-damenrasierer/\">Damenrasierer</a></li><li><a href=\"/beste-duschschaum/\">Duschschaum</a></li></ul>\n<ul><li>Entgiftungstee</li></ul>\n<ul><li><a href=\"/beste-selbstbraeuner/\">Selbstbräuner</a></li></ul>\n<ul><li><a href=\"/beste-whirlpool-aufblasbar/\">Whirlpool Aufblasbar</a></li></ul>"]];
const faq = [];
---
<PageLayout
  title={"Körperpflege - erwachsenenfragen.de"}
  description={"In der Kategorie Körperpflege finden Sie verschiedene Produkte zur Pflege Ihres Körpers. Denken Sie an einen Badeschaum, ein Entgiftungstee, einen Damenrasierer, einen Duschschaum und vieles mehr. Sehen Sie sich alle unsere ausführlichen Bewertungen der Artikel in der Kategorie Körperpflege an."}
  h1={"Körperpflege"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
