const faq = [];
---
<PageLayout
  title={"Impressum - erwachsenenfragen.de"}
  description={"Angaben gemäß § 5 TMG Name des Unternehmens / BetreibersZB SEO LLP KontaktE-Mail: Contact Vertreten durchRogier Haftung für Inhalte Als Diensteanbieter sind wir gemäß § 7 Abs.1 TMG für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 TMG sind wir jedoch nicht verpflichtet, übermittelte oder gespeicherte fremde Informationen […]"}
  h1={"Impressum"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
