---
import PageLayout from "../../layouts/PageLayout.astro";
const html = "<h2 id=\"nehmen-sie-kontakt-mit-uns-auf\">Nehmen Sie Kontakt mit uns auf!</h2>\n<p>Haben Sie Fragen oder Anmerkungen zu unserer Website? Wenn ja, können Sie das Formular auf dieser Seite ausfüllen, um mit unserer Redaktion in Kontakt zu treten. Wenn Sie ein Thema haben, über das Sie gerne einen Blog sehen würden, lassen Sie es uns wissen. Auch wenn Sie auf dieser Website werben möchten, hinterlassen Sie uns bitte eine Nachricht. Unsere Redakteure stehen Ihnen jeden Tag zur Verfügung.</p><form class=\"form\" action=\"https://api.web3forms.com/submit\" method=\"POST\" data-contact-form>\n<input type=\"hidden\" name=\"access_key\" value=\"281f477d-7744-407d-9b6a-9b8d9c6abe3c\" />\n<input type=\"hidden\" name=\"subject\" value=\"Neue Nachricht ueber erwachsenenfragen.de\" />\n<input type=\"hidden\" name=\"from_name\" value=\"Erwachsenenfragen\" />\n<label class=\"hp\" aria-hidden=\"true\">Bot<input type=\"checkbox\" name=\"botcheck\" tabindex=\"-1\" autocomplete=\"off\" /></label>\n<h2 style=\"margin-top:0\">Schreiben Sie uns</h2>\n<div class=\"form-row form-2\">\n<div class=\"field\">\n<label for=\"cf-name\">Name <span class=\"req\" aria-hidden=\"true\">*</span></label>\n<input id=\"cf-name\" name=\"name\" type=\"text\" required autocomplete=\"name\" placeholder=\"Ihr Name\" />\n</div>\n<div class=\"field\">\n<label for=\"cf-email\">E-Mail-Adresse <span class=\"req\" aria-hidden=\"true\">*</span></label>\n<input id=\"cf-email\" name=\"email\" type=\"email\" required autocomplete=\"email\" placeholder=\"sie@beispiel.de\" />\n</div>\n</div>\n<div class=\"field\">\n<label for=\"cf-message\">Nachricht <span class=\"req\" aria-hidden=\"true\">*</span></label>\n<textarea id=\"cf-message\" name=\"message\" rows=\"6\" required placeholder=\"Womit koennen wir Ihnen helfen?\"></textarea>\n</div>\n<button class=\"btn\" type=\"submit\" data-send=\"Absenden\" data-sending=\"Wird gesendet...\">Absenden</button>\n<p class=\"form-status\" role=\"status\" aria-live=\"polite\"></p>\n<p class=\"form-note\">Wir verwenden Ihre Daten ausschliesslich zur Beantwortung Ihrer Nachricht.</p>\n</form>";
const faq = [];
---
<PageLayout
  title={"Kontaktieren Sie uns - AdultVragen.de"}
  description={"Sie möchten Kontakt zu unserer Redaktion aufnehmen? Dann können Sie dies ganz einfach über unsere Kontaktseite tun. Unser Team steht Ihnen jeden Tag zur Verfügung!"}
  h1={"Kontaktieren Sie uns - AdultVragen.de"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  <Fragment set:html={html} />
</PageLayout>
